# Execution Mode: "simulator" (offline sandbox demo) or "hybrid" (Cloud API + Local Proxy Verifier)
SKILL_PRO_MODE=simulator

# Cloud API Executor (OpenAI-compatible endpoint, used when SKILL_PRO_MODE=hybrid)
EXECUTOR_BASE_URL=https://api.openai.com/v1
EXECUTOR_MODEL=gpt-4o-mini
EXECUTOR_API_KEY=REDACTED_SECRET

# Local Proxy Logprob Verifier (Option B: local vLLM / Ollama-compatible endpoint on 127.0.0.1)
PROXY_VERIFIER_MODE=offline_proxy
PROXY_VERIFIER_URL=http://127.0.0.1:11434/v1
PROXY_VERIFIER_MODEL=qwen3:4b
PROXY_VERIFIER_API_KEY=local-proxy

# Storage & Server Binding (localhost only for OpSec safety)
SKILL_PRO_DB_PATH=data/skill_pro.db
SKILL_PRO_HOST=127.0.0.1
SKILL_PRO_PORT=8420
